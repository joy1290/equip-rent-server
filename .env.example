# Server port (local development)
PORT=5000

# MongoDB connection string — keep this secret, never commit the real value
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/equip-rent

# Better Auth
# Local development default: http://localhost:5000
# Production (Vercel):       https://equip-rent-server.vercel.app
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=generate_a_long_random_secret

# Allowed frontend origin (CORS + OAuth redirect base)
# Local development default: http://localhost:3000
# Production (Vercel):       https://equip-rent-client.vercel.app
FRONTEND_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# imgbb image upload (https://api.imgbb.com/) — used by POST /api/uploads/imgbb
IMGBB_API_KEY=

# Optional: completion email notifications (nodemailer).
# When SMTP_HOST / SMTP_USER / SMTP_PASS are unset, emails are skipped with a log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EquipRent <no-reply@example.com>
